# Copy to .env and fill in your values. .env is git-ignored — never commit it.
# gemini-flash-lite-latest has the highest free-tier rate limit (~15+ RPM).
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-flash-lite-latest

# Google OAuth — create in Google Cloud Console → Credentials → OAuth client ID (Web application)
# Authorized JavaScript origins: http://localhost:5173
# (Public client — no client secret needed for the "Sign in with Google" button flow.)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com