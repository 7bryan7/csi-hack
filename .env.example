# Copy to .env and fill in your values. .env is git-ignored — never commit it.
# gemini-flash-lite-latest has the highest free-tier rate limit (~15+ RPM).
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-flash-lite-latest

# Google OAuth — create in Google Cloud Console → Credentials → OAuth client ID (Web application)
# Authorized JavaScript origins: http://localhost:5173
# (Public client — no client secret needed for the "Sign in with Google" button flow.)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# --- Base Sepolia (PRD v2 §6.3) ---
# Public RPC works without a key; a private RPC (Alchemy/Infura) is optional.
BASE_SEPOLIA_RPC=https://sepolia.base.org
# Deployer wallet private key — must hold testnet ETH from the Base Sepolia faucet.
# NEVER commit the real .env; this file is the safe template.
PRIVATE_KEY=
# Optional: Basescan API key for contract verification (free tier).
BASESCAN_API_KEY=
# Optional: treasury address (defaults to deployer).
TREASURY=
# Operator wallet — the only address that can view the platform treasury
# dashboard. Every other wallet is a regular user. Defaults to the hackathon
# operator address.
OPERATOR_ADDRESS=0x26839094202c7582DE5279eB61239B55C481Fe2d
